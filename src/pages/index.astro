---
const strengths = [
  "디자인씽킹으로 문제를 정의하고 AI 워크플로로 구현까지 완결 — 캡스톤디자인(우수상)·글로벌 스타트업 해커톤(동상)·창업아이디어 경진대회(은상)에서 연속 수행",
  "LLM 에이전트 파이프라인 설계·구현 — Claude Code 스킬(오케스트레이터 + 서브에이전트 11개), Dify 멀티에이전트, RAG 챗봇, MCP 서버(도구 4종, stdio JSON-RPC)",
  "AI 워크플로 품질을 감이 아니라 수치로 검증 — 골든셋 60케이스 회귀 평가 하네스와 CI를 직접 구축해 정확도 57/60 → 60/60, 응답시간 4.19s → 1.14s 실측",
  "모델링 전 과정 수행 — 도메인 기반 피처 엔지니어링, 데이터 누수 적발·제거, 과적합 방어 앙상블로 ML 컴피티션 2등. 빅데이터분석기사·ADsP·SQLD 보유",
];

const projects = [
  {
    name: "BozorCheck AI",
    meta: "글로벌 스타트업 해커톤 · 동상 · 2026.06–07",
    role: "Dify 워크플로 3종 설계·구축, 평가 하네스, 레퍼런스 백엔드",
    body: "우즈베키스탄 재래시장 시세 조회 서비스의 AI 파트. 가격 계산·판정은 백엔드가 단일 진실 원천이고 LLM은 설명 계층만 담당하도록 역할을 분리했다. 현지 학생 인터뷰 결과를 의사결정 기준으로 삼아 주제를 두 번 피벗했다.",
    metrics: [
      "가격 제보 검증을 기본 검증 → 규칙 평가 → LLM 이상치 리뷰 → 출력 파이프라인으로 분해해 'Report Inspector' 에이전트 설계",
      "프로젝트 종료 후 골든셋 60케이스 + LLM-as-judge 없는 결정론적 채점기 + GitHub Actions CI로 회귀 평가 하네스를 직접 구축",
      "재현 평가에서 실패 3건의 원인(지식베이스 검색 경쟁, 우즈베크어 동형이의어)을 진단·수정 → 57/60(95%) → 60/60",
      "별도 holdout 재측정 14/15(93%) — 튜닝에 쓴 데이터로 잰 수치와 분리해 기록",
      "규칙 기반 사전 필터로 LLM 우회 경로 응답 4.19s → 1.14s (약 73% 단축, 해당 비율만큼 API 비용 미발생)",
    ],
    stack: "Dify · Python · Claude Code · GitHub Actions · Docker",
    links: [["GitHub", "https://github.com/hyunbean/tuit_hackathon_dify"]],
  },
  {
    name: "ML 컴피티션 — 고객 성별 예측",
    meta: "교내 경진대회 · 2등 · 2026.05–06",
    role: "파이프라인 설계, 피처 엔지니어링, 앙상블·제출 전략",
    body: "카드 소비 데이터로 고객 성별을 예측하는 이진 분류(ROC-AUC). Public 1위로 마쳤으나 Private에서 2위로 역전당했고, 왜 졌는지를 상위 솔루션과 대조 분석한 회고가 이 프로젝트의 핵심 자산이다.",
    metrics: [
      "도메인 지식 체계화 → 후보 피처 생성 → 중요도 기반 정제 순으로 피처 엔지니어링을 구조화",
      "서로 다른 모델링 접근 57개를 설계·구현 — 최종 앙상블 120개 모델 중 108개가 여기서 나옴",
      "개별 모델 천장 0.71~0.72 → 4단계 앙상블로 0.738",
      "데이터 누수 피처 적발 — 부풀려진 +0.005가 OOF 재계산 후 +0.00156로 축소",
      "갭–public 상관 +0.63(과적합형) vs 우승팀 −0.19 — 역전패의 원인을 정량화",
    ],
    stack: "Python · CatBoost · XGBoost · LightGBM · scikit-learn · pandas",
    links: [["GitHub", "https://github.com/hyunbean/ML_Final_Competition"]],
  },
  {
    name: "Design Thinking Pipeline",
    meta: "오픈소스 · Claude Code 스킬 · 2026.03–07",
    role: "오케스트레이터 + 11개 서브에이전트 프롬프트 전량 설계",
    body: "디자인씽킹 6단계를 단계별 서브에이전트로 분리해 입출력을 명확히 정의하고 체이닝으로 자동화한 스킬. 각 스텝을 새 컨텍스트로 실행해 앞 단계가 뒤 단계 출력을 오염시키지 않도록 격리했고, 인터뷰 구간은 근거 데이터가 되므로 자동화하지 않고 사람을 기다리도록 강제했다.",
    metrics: [
      "MCP 서버 별도 구현 — 도구 4종을 stdio JSON-RPC로 노출",
      "LLM을 직접 호출하지 않고 방법론만 제공 — 산출물 생성은 클라이언트 모델이 수행",
      "최소 권한 원칙 — 텍스트 스텝은 Read만, 이미지 스텝만 Write/Bash",
    ],
    stack: "Claude Code Skill · MCP(Node, stdio JSON-RPC) · Python",
    links: [["GitHub", "https://github.com/hyunbean/DesignThinking"]],
  },
  {
    name: "주머니 (ZooMoney)",
    meta: "캡스톤디자인 · 우수상 · 2026.03–06",
    role: "디자인씽킹 전 과정 + Dify 에이전트 5종 설계·구축",
    body: "가계부 사용자 3유형을 1:1 심층 인터뷰해 \"지속은 기능이 아니라 동기·목표에서 갈린다\"는 인사이트를 도출하고, 목표 설정부터 캐릭터 성장까지 기능을 설계했다. API 키는 Cloudflare Worker 게이트웨이 뒤에만 두고 프론트는 에이전트 이름만 전달한다.",
    metrics: [
      "Dify 에이전트 5종 설계·구축 (목표설정·소비분석·예산플래닝·트레이너챗봇·소비요약)",
      "지식베이스 + RAG(Cohere 리랭킹) 기반 절약팁 챗봇 구현",
      "게이트웨이를 직접 호출해 토큰·비용·지연 실측 — 평균 호출당 $0.000087",
    ],
    stack: "JavaScript · CSS · Cloudflare Workers · Dify · Cohere Rerank",
    links: [
      ["라이브 데모", "https://hyunbean.github.io/ZooMoney/"],
      ["GitHub", "https://github.com/hyunbean/ZooMoney"],
    ],
  },
];

const others = [
  ["LG헬로비전 기업연계 프로젝트", "2024.09–12", "GA 전권으로 유입·전환·이탈을 분석하고 홈페이지 UI 개선안과 A/B 테스트를 설계해 기업에 전달"],
  ["SilentGuard", "창업아이디어 경진대회 · 은상 · 2026.04–05", "독거노인 이상탐지 서비스 기획. 종료 후 UCI 가정 전력 데이터(34,168시간)로 로직을 직접 구현해 z-threshold별 재현율·오탐률을 실측"],
];

const skills = [
  ["데이터 분석", "GA 퍼널·시계열·UI 클릭 분석, 피처 엔지니어링, 과적합 관리·앙상블 모델링"],
  ["AI 구현", "Claude Code 서브에이전트·스킬 프롬프트 설계, MCP 서버 구현, Dify 에이전트·RAG 챗봇, 멀티에이전트 협업 구조 설계, 회귀 평가 하네스 구축"],
  ["서비스 기획", "디자인씽킹 — 고객 인터뷰 → 문제 정의 → 프로토타입"],
  ["Tools", "Python, SQL, HTML/CSS/JavaScript, GA, Dify, Git, Claude Code"],
];

const awards = [
  ["동상 — 글로벌 스타트업 해커톤", "국민대학교", "2026-07"],
  ["우수상 — 캡스톤디자인", "국민대학교", "2026-06"],
  ["은상 — 제19회 경영대학 창업데이 창업아이디어 경진대회", "국민대학교", "2026-05"],
];

const certs = [
  ["빅데이터분석기사", "2025-12"],
  ["ADsP 데이터분석 준전문가", "2025-03"],
  ["SQLD SQL 개발자", "2024-09"],
];
---

<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>신현빈 — AI 서비스 개발 · 데이터</title>
    <meta name="description" content="디자인씽킹으로 문제를 정의하고, LLM 에이전트와 데이터 분석으로 구현·검증합니다." />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css"
    />
    <style>
      :root {
        --bg: #fff; --fg: #222; --muted: #666; --sub: #333;
        --line: #eee; --accent: #3a7bd5; --accent2: #00d2ff;
      }
      * { box-sizing: border-box; }
      ::selection { background: var(--accent2); }

      html, body {
        margin: 0;
        font-size: 16px;
        word-break: keep-all;
        font-family: "Pretendard Variable", Pretendard, -apple-system,
          BlinkMacSystemFont, "Apple SD Gothic Neo", "Noto Sans KR", "Segoe UI",
          Roboto, "Malgun Gothic", sans-serif;
        letter-spacing: -0.3px;
        background: var(--bg);
        color: var(--fg);
        padding-bottom: 2rem;
        overflow-x: hidden;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
      }
      @media screen and (max-width: 960px) {
        html, body { font-size: 14px; }
      }

      /* 상단 고정 그라디언트 바 — 레퍼런스 UI의 시그니처. */
      body::before {
        position: fixed; z-index: 1; top: 0; left: 0;
        display: block; content: ""; width: 100%; height: 10px;
        background: linear-gradient(90deg, var(--accent), var(--accent2));
      }

      .container { width: 100%; max-width: 50rem; margin: auto; }
      section { padding: 0 2rem; }

      h1 { font-size: 5rem; line-height: 1.1; }
      h2 { font-size: 3rem; margin: 4rem 0 2rem; }
      h3, h4 { font-size: 2rem; margin: 0 0 1rem; }
      h5 { font-size: 1.3rem; margin: 0 0 .5rem; color: var(--sub); }
      @media screen and (max-width: 960px) {
        h1 { font-size: 3rem; }
        h4 { font-size: 1.5rem; }
      }

      p { margin: 0 0 1rem; font-size: 1.1rem; line-height: 1.4; }
      a { color: var(--accent); transition: color .3s ease; text-decoration: none; }
      a:hover { color: var(--accent2); }

      ul { list-style: none; padding: 0; margin: 0 0 1rem; font-size: 1.1rem; }
      ul > li { position: relative; padding: .2rem 0 .2rem 1rem; line-height: 1.4; }
      ul > li::before {
        position: absolute; left: 0; display: inline-block;
        content: "\2022"; color: var(--accent);
      }

      .big-paragraph { font-size: 2rem; line-height: 1.4; font-weight: 500; }
      @media screen and (max-width: 960px) {
        .big-paragraph { font-size: 1.5rem; }
      }

      .row { display: flex; padding: 3rem 0; border-bottom: 1px solid var(--line); }
      .row-left { flex-basis: 18rem; padding-right: 1rem; flex-shrink: 0; }
      .row-right { flex-grow: 1; }
      @media screen and (max-width: 960px) {
        .row { flex-direction: column; }
        .row-left { flex-basis: 100%; padding-right: 0; padding-bottom: 1rem; }
      }

      .other { padding: 3rem 0; border-bottom: 1px solid var(--line); }
      /* 설명 없는 한 줄짜리 항목(수상·자격·학력)에 3rem은 지면 낭비. */
      .other.compact { padding: 1.25rem 0; }
      .other.compact h4 { font-size: 1.3rem; margin-bottom: .15rem; }
      .other.compact .time { margin-bottom: 0; }
      .role { display: block; color: var(--muted); font-size: 1rem; line-height: 1.4; }
      .time { display: block; margin-bottom: 1.5rem; color: var(--muted); font-size: 1rem; }
      .links { display: flex; flex-wrap: wrap; gap: 1.25rem; font-size: 1.1rem; }
      footer { padding: 3rem 2rem 0; color: var(--muted); font-size: 1rem; }

      @media print {
        /* 이 페이지가 곧 이력서 PDF의 소스다. 컬러 액센트는 흑백 인쇄에서 죽으므로 검정 강제. */
        :root {
          --bg: #fff; --fg: #111; --muted: #444; --sub: #222;
          --line: #ccc; --accent: #111; --accent2: #111;
        }
        @page { size: A4; margin: 12mm; }
        body::before { display: none; }
        /* rem은 html 기준이라 body 축소로는 안 줄어든다 — 인쇄용 크기는 전부 pt로 명시. */
        html, body { font-size: 9.5pt; padding-bottom: 0; }
        .container { max-width: none; }
        section { padding: 0; }
        h1 { font-size: 20pt; margin: 0 0 .3rem; }
        h2 { font-size: 12pt; margin: 1.1rem 0 .5rem; }
        h3 { font-size: 12pt; margin: 0 0 .2rem; }
        h4 { font-size: 11pt; margin: 0 0 .2rem; }
        h5 { font-size: 8.5pt; margin: 0 0 .15rem; }
        p, ul { font-size: 9.5pt; margin-bottom: .35rem; }
        li { padding: .05rem 0 .05rem 1rem; }
        .big-paragraph { font-size: 11pt; font-weight: 500; }
        .role, .time, .links, footer { font-size: 9pt; }
        .time { margin-bottom: .4rem; }
        .row, .other {
          padding: .5rem 0;
          break-inside: avoid; page-break-inside: avoid;
        }
        .row-left { flex-basis: 12rem; }
        a { color: inherit; text-decoration: underline; }
        /* 인쇄본에선 헤더 연락처와 중복 — 지면만 먹는다. */
        footer { display: none; }
      }
    </style>
  </head>
  <body>
    <div class="container">
      <section>
        <h1>반갑습니다,<br />저는 신현빈입니다</h1>
        <p class="big-paragraph">
          디자인씽킹으로 문제를 정의하고 LLM 에이전트와 데이터 분석으로 구현합니다.
          AI는 가속 도구로 쓰되, 판단과 검증은 수치로 남깁니다.
        </p>
        <div class="links">
          <a href="mailto:guszhd95@gmail.com">guszhd95@gmail.com</a>
          <a href="https://github.com/hyunbean">GitHub</a>
          <a href="https://app.notion.com/p/39a737e11aeb811c93b1db3175843024?source=copy_link">포트폴리오</a>
        </div>
      </section>

      <section>
        <h2>핵심 역량</h2>
        <ul>{strengths.map((s) => <li>{s}</li>)}</ul>
      </section>

      <section>
        <h2>프로젝트</h2>
        {projects.map((p) => (
          <div class="row">
            <div class="row-left">
              <h3>{p.name}</h3>
              <span class="role">{p.meta}</span>
            </div>
            <div class="row-right">
              <h5>Role</h5>
              <p>{p.role}</p>
              <h5>Description</h5>
              <p>{p.body}</p>
              <h5>What did I do</h5>
              <ul>{p.metrics.map((m) => <li>{m}</li>)}</ul>
              <h5>Tech Stack</h5>
              <p>{p.stack}</p>
              <div class="links">
                {p.links.map(([label, href]) => <a href={href}>{label} →</a>)}
              </div>
            </div>
          </div>
        ))}
      </section>

      <section>
        <h2>그 외</h2>
        {others.map(([name, meta, body]) => (
          <div class="other">
            <h4>{name}</h4>
            <span class="time">{meta}</span>
            <p>{body}</p>
          </div>
        ))}
      </section>

      <section>
        <h2>기술</h2>
        {skills.map(([name, body]) => (
          <div class="row">
            <div class="row-left"><h4>{name}</h4></div>
            <div class="row-right"><p>{body}</p></div>
          </div>
        ))}
      </section>

      <section>
        <h2>수상</h2>
        {awards.map(([name, org, when]) => (
          <div class="other compact">
            <h4>{name}</h4>
            <span class="time">{org} · {when}</span>
          </div>
        ))}
      </section>

      <section>
        <h2>자격</h2>
        {certs.map(([name, when]) => (
          <div class="other compact">
            <h4>{name}</h4>
            <span class="time">{when}</span>
          </div>
        ))}
      </section>

      <section>
        <h2>학력</h2>
        <div class="other compact">
          <h4>국민대학교</h4>
          <span class="time">
            경영정보학부 비즈니스IT전공 · 인포메이션테크놀로지전공(제2전공) · 2027.02 졸업 예정
          </span>
        </div>
      </section>

      <footer>
        신현빈 · <a href="mailto:guszhd95@gmail.com">guszhd95@gmail.com</a> ·
        <a href="https://github.com/hyunbean">github.com/hyunbean</a>
      </footer>
    </div>
  </body>
</html>
